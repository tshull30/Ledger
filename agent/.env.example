# Copy this file to .env (in the agent folder) and fill it in.
# Wallet keys and POLICY_ADDRESS are read from contracts/.env automatically.

# Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Which Gemini markets to watch, and which research topic goes with each.
# Format: SYMBOL=topic,SYMBOL2=topic2     (find symbols with: npm run markets)
WATCHLIST=

# paper   = log trades only, no account needed (start here)
# sandbox = Gemini sandbox, fake money (needs sandbox API key below)
# live    = REAL MONEY (needs real Gemini API key below)
TRADE_MODE=paper
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Strategy (optional; these are the defaults)
MIN_EDGE=0.05
MIN_CONFIDENCE=0.5
MAX_STAKE_USD=25
LOOP_MINUTES=15
APPROVAL_WAIT_MINUTES=10
GEMINI_FEE_RATE=0.07
